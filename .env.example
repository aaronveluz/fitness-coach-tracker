# ─────────────────────────────────────────────────────────────────────────────
# ROOT .env.example
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=EnterpriseApp
APP_PORT=4000

# ── Database (MariaDB) ───────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=enterprise_db
DB_USER=root
DB_PASSWORD=your_db_password
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_at_least_64_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Security ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Redis (for BullMQ job queues — optional in dev) ──────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Frontend (Vite build-time variables — prefix with VITE_) ─────────────────
VITE_API_BASE_URL=http://localhost:4000/api
